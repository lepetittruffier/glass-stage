# GLASS STAGE v2 — Ghostty · generated by v2/build.py
# https://www.intelligencematters.se/epoq/system.css · sha256 00d77d5d1165 · 2026-10-13 07:38 CEST
# One object, two grounds: the stage in the dark, the paper terminal in the light.
# Ghostty follows the macOS appearance; the two theme files carry every colour.
theme = light:glass-paper,dark:glass-stage
window-theme = auto

# the type — --font-mono at --fz-mono-cli 14 / --lh-mono-cli 1.5
font-family = "Red Hat Mono"
font-size = 14
# Red Hat Mono leads at 1.323 on its own (hhea 1018 + 305 / 1000): 1.5 / 1.323 = +13%
adjust-cell-height = 13%
font-thicken = false
# E1 — bold is not a voice here. The tism is (E12): SGR bold sets in Red Hat Mono Italic.
font-style-bold = Italic
font-style-bold-italic = Italic
# --hairline is the only stroke: underline + strike thinned to 0.5 at 14 (1.40 / 0.70 in the font)
adjust-underline-thickness = -64%
adjust-strikethrough-thickness = -29%

# the door — the canon cursor is ▌, half a cell: a bar at half the 8.4 advance
cursor-style = bar
adjust-cursor-thickness = 4
cursor-style-blink = true

# the frame — .term-stream pads var(--s-3). The stage is the ground and stays opaque:
# glass is for agency surfaces only (the main-view law, 2026-07-17).
window-padding-x = 24
window-padding-y = 24
window-padding-balance = true
window-padding-color = background
background-opacity = 1
macos-titlebar-style = transparent
macos-option-as-alt = true
bold-is-bright = false
# an unfocused split sinks to --glass-alpha
unfocused-split-opacity = 0.6
minimum-contrast = 1
mouse-hide-while-typing = true
